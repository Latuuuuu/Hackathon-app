# Copy to .env and fill in. .env is git-ignored: keep tokens there only.

# ---- BT engine (mc_main_nav) ----
# LAN: http://192.168.50.125:8090   public: https://mcpc.taile84e23.ts.net
BT_ENGINE_URL=http://192.168.50.125:8090
BT_ENGINE_TOKEN=

# ---- Cloud task server (LLM agent) ----
# mock = log prompts/feedback to data/*.jsonl; http = forward to CLOUD_URL (/tasks, /feedback)
CLOUD_MODE=mock
CLOUD_URL=
CLOUD_TOKEN=
# Mock only: also run a demo tree on bt_engine. THIS MOVES THE REAL ROBOT.
MOCK_EXECUTE=false
# MOCK_TREE_FILE=/path/to/tree.xml

# ---- Calibration (set by docker/compose.yaml; override only for local dev) ----
# CALIB_MODE=auto            # auto | ros | mock
# FIELD_FILE=./data/field_app.yaml
# CALIB_OUTPUT_DIR=./data/calib_out

